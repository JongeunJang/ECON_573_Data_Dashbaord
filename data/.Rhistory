Avg_Length = colMeans(lengths)
)
print(result)
library(AER)
set.seed(1)
R <- 1000
n <- 30
true_beta <- 1
cover  <- matrix(0, R, 4)
lengths <- matrix(0, R, 4)
colnames(cover) <- colnames(lengths) <- c("Homo","HC0","HC2","HC3")
for (r in 1:R){
# DGP
X <- rnorm(n,0,1)
e <- runif(n,-1,1)
U <- X * e
Y <- 1 + X + U
# OLS
model <- lm(Y ~ X)
# 1) Homoskedastic SE
se_homo <- summary(model)$coefficients[2,2]
CI_homo <- confint(model,level=0.95)[2,]
cover[r,"Homo"]   <- true_beta >= CI_homo[1] && true_beta <= CI_homo[2]
lengths[r,"Homo"] <- CI_homo[2] - CI_homo[1]
# 2) HC0
hc0 = coeftest(model,vcov=hccm(model,type="hc0"))
se_hc0 <- hc0[2,2]
CI_hc0 <- confint(hc0,level=0.95)[2,]
cover[r,"HC0"]   <- true_beta >= CI_hc0[1] && true_beta <= CI_hc0[2]
lengths[r,"HC0"] <- CI_hc0[2] - CI_hc0[1]
# 3) HC2
hc2 = coeftest(model,vcov=hccm(model,type="hc2"))
se_hc2 <- hc2[2,2]
CI_hc2 <- confint(hc2,level=0.95)[2,]
cover[r,"HC2"]   <- true_beta >= CI_hc2[1] && true_beta <= CI_hc2[2]
lengths[r,"HC2"] <- CI_hc2[2] - CI_hc2[1]
# 4) HC3
hc3 = coeftest(model,vcov=hccm(model,type="hc3"))
se_hc3 <- hc3[2,2]
CI_hc3 <- confint(hc3,level=0.95)[2,]
cover[r,"HC3"]   <- true_beta >= CI_hc3[1] && true_beta <= CI_hc3[2]
lengths[r,"HC3"] <- CI_hc3[2] - CI_hc3[1]
}
# --- 요약 ---
result <- data.frame(
Coverage = colMeans(cover),
Avg_Length = colMeans(lengths)
)
print(result)
