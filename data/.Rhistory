zillow_clean <- zillow_raw %>%
# Pivot date columns (e.g., 2000-01-31) from wide format to long format
pivot_longer(
cols = matches("^19|^20"), # Select columns starting with 19xx or 20xx (dates)
names_to = "date",
values_to = "zhvi_value"
) %>%
mutate(
# Create 5-digit FIPS code (2-digit State + 3-digit County)
StateCodeFIPS = str_pad(StateCodeFIPS, width = 2, pad = "0"),
MunicipalCodeFIPS = str_pad(MunicipalCodeFIPS, width = 3, pad = "0"),
fips = paste0(StateCodeFIPS, MunicipalCodeFIPS)
# Convert date format (string -> date)
date = ymd(date)
zillow_clean <- zillow_raw %>%
# Pivot date columns (e.g., 2000-01-31) from wide format to long format
pivot_longer(
cols = matches("^19|^20"), # Select columns starting with 19xx or 20xx (dates)
names_to = "date",
values_to = "zhvi_value"
) %>%
mutate(
# Create 5-digit FIPS code (2-digit State + 3-digit County)
StateCodeFIPS = str_pad(StateCodeFIPS, width = 2, pad = "0"),
MunicipalCodeFIPS = str_pad(MunicipalCodeFIPS, width = 3, pad = "0"),
fips = paste0(StateCodeFIPS, MunicipalCodeFIPS),
# Convert date format (string -> date)
date = ymd(date)
) %>%
# Select only the essential columns needed for the dashboard
select(fips, RegionName, StateName, date, zhvi_value) %>%
# Remove rows with missing home value data (NAs)
drop_na(zhvi_value)
View(Angrist)
