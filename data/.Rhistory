library(dplyr)
library(tidyr)
library(readr)
library(stringr)
library(lubridate)
fema_clean <- fema_raw %>%
# Filter for Hurricanes and major disaster (DR)
filter(incidentType == "Hurricane", declarationType == "DR") %>%
# Create 5-digit FIPS code (2-digit State + 3-digit County)
mutate(
fipsStateCode = str_pad(fipsStateCode, width = 2, pad = "0"),
fipsCountyCode = str_pad(fipsCountyCode, width = 3, pad = "0"),
fips = paste0(fipsStateCode, fipsCountyCode),
# Convert string dates to Date objects
incident_date = as.Date(incidentBeginDate)
) %>%
# Select only the essential columns needed for the dashboard
select(fips, femaDeclarationString, incident_date, hurricane_name = declarationTitle)
